# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Biblioteca local de assets 3D (pesada, .blend/GLB de trabajo) — no va al repo
/biblioteca de assets/
# Config local del MCP de Blender (rutas de esta máquina)
/.mcp.json

# Modelos 3D de prueba con licencia SIN VERIFICAR (no se publican hasta tener origen/licencia): ver docs/3d/asset-registry.json
/public/models/*.glb

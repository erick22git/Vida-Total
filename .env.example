# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local (está en .gitignore).
# Los valores de abajo son FALSOS: solo muestran qué variables existen.

# --- Supabase (público: URL y anon key) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# --- SOLO SERVIDOR (en Vercel: Settings → Environment Variables; nunca con prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Modelo de lenguaje (Groq): escáner de comida, agente y notas de voz
GROQ_API_KEY=TU_API_KEY_AQUI
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Telegram (ver docs/telegram.md) ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=000000000:TOKEN_FALSO_DE_EJEMPLO
# Nombre de usuario del bot, sin @ (sirve para el botón "Abrir en Telegram")
TELEGRAM_BOT_USERNAME=mi_bot_de_ejemplo
# Secreto largo y aleatorio (≥ 32 caracteres) que registras en setWebhook; Telegram lo manda en cada petición
TELEGRAM_WEBHOOK_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-0000
# URL pública de la app (para el script de setWebhook), sin barra final
APP_PUBLIC_URL=https://tu-app.vercel.app

# --- Programador de avisos (ver docs/notificaciones.md) ---
# Secreto que el programador manda como "Authorization: Bearer <CRON_SECRET>" a /api/agent/tick
CRON_SECRET=otro-secreto-largo-y-aleatorio-0000000000
